# Common settings that generally should always be used with your language specific settings
*          text=auto

# Documents
*.md       text diff=markdown
*.mdx      text diff=markdown
*.csv      text eol=crlf
*.txt      text

# Graphics
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.tif      binary
*.tiff     binary
*.ico      binary
*.svg      text

# Scripts
*.bash     text eol=lf
*.sh       text eol=lf
*.zsh      text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Serialization
# The cooker writes LF, and the stage dumps under tests/known_good are compared against cooker
# output byte for byte. A CRLF working tree would fail that comparison on line endings alone.
*.json     text eol=lf
*.toml     text
*.xml      text
*.yaml     text
*.yml      text

# Sources
*.cpp   text diff=cpp
*.hpp   text diff=cpp
*.inl   text diff=cpp

.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore

